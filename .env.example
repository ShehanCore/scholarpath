# Copy to .env.local for local development. Without these, the app reads content from design/data.
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never prefix with NEXT_PUBLIC_. Needed to save ranks in the admin and "Notify me" requests.
SUPABASE_SECRET_KEY=sb_secret_...

# Admin login for /admin (HTTP Basic auth until accounts have an admin role). Without these, /admin returns 404.
# Use a long random password; set them in Vercel too.
ADMIN_USER=editor
ADMIN_PASSWORD=

# "Notify me when it reopens" emails (sent by the daily job in vercel.json, 07:45 Sri Lanka time).
# Resend API key and a From address on a domain verified in Resend. Without them, requests are saved and wait.
RESEND_API_KEY=
ALERTS_FROM_EMAIL="ScholarPath <alerts@scholarpath.lk>"
# Vercel sends this as a Bearer token to the cron route; any long random string.
CRON_SECRET=
# Public site address used in email links.
NEXT_PUBLIC_SITE_URL=https://scholarpath.lk
